{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "af3c12db2eeef188b7e3c9809a5852c5ff6315d3",
  "always-update": true,
  "packages": {
    ".": {
      "release-type": "node",
      "changelog-type": "github",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "include-v-in-release-name": true,
      "pull-request-title-pattern": "chore: release v${version}",
      "draft": true,
      "force-tag-creation": true,
      "exclude-paths": ["site"],
      "extra-files": [
        {
          "type": "json",
          "path": "src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/crates/rem-core/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/crates/rem-cli/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==\"app\")].version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==\"rem-core\")].version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==\"rem-cli\")].version"
        }
      ]
    }
  }
}
